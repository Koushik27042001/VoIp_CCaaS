PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/voip_ccaas
JWT_SECRET=replace-with-a-long-random-secret

# Public URL Twilio can reach (required for webhooks). Use ngrok for local dev.
PUBLIC_API_URL=https://your-public-domain-or-ngrok-url

# Twilio credentials (Console → Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19124916443

# Twilio Voice SDK (Console → API Keys + TwiML Apps)
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

# Webhook validation (set true in production)
TWILIO_VALIDATE_WEBHOOKS=false

# Asterisk (optional — used when AMI password is set)
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASSWORD=
ASTERISK_WS_PUBLIC_URL=wss://your-asterisk-host:8089/ws
ASTERISK_SIP_DOMAIN=your-asterisk-host

# Admin seed script
SEED_ADMIN_EMAIL=admin@ccaas.local
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME=System Admin
