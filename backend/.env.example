PORT=5000
MONGO_URI=mongodb://localhost:27017/voip_ccaas
JWT_SECRET=replace-with-a-long-random-secret
USE_MOCK=true
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=300
SIGNALING_RATE_LIMIT_PER_MINUTE=120
SIP_TRUNK_SECRET_KEY=replace-with-32-byte-secret
ASTERISK_CONFIG_DIR=./generated/asterisk
ASTERISK_RELOAD_ENABLED=false
ASTERISK_CLI_ENABLED=false
ASTERISK_WSS_PORT=8089
ASTERISK_RTP_START=10000
ASTERISK_RTP_END=20000
AGENT_EXTENSION_START=1001
AGENT_EXTENSION_COUNT=20
AGENT_EXTENSION_PASSWORD_PREFIX=agent
