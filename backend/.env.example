PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/voip_ccaas
JWT_SECRET=change-me-in-production

# Public URL for Twilio webhooks (use ngrok in dev)
PUBLIC_API_URL=http://localhost:5000

# --- Twilio PSTN (agent → real mobile) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Asterisk PBX (SIP.js + extension dialing) ---
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASSWORD=
ASTERISK_WS_PUBLIC_URL=ws://127.0.0.1:8088/ws
ASTERISK_SIP_DOMAIN=127.0.0.1
ASTERISK_OUTBOUND_CONTEXT=outbound-mobile

LOG_LEVEL=info
