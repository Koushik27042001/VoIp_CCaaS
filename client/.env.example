REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000

# Auto-register telecom on agent login
REACT_APP_AUTO_TELECOM_INIT=true
REACT_APP_ENABLE_TWILIO_CLIENT_CALLING=false

# Legacy SIP (optional fallback when Twilio Client is unavailable)
REACT_APP_AUTO_SIP_REGISTER=false
REACT_APP_SIP_ENABLED=false
